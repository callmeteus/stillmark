---
import "../styles/global.css";

interface Props {
    title: string;
    description: string;
    lang: string;
    skipToContent: string;
}

const { title, description, lang, skipToContent } = Astro.props;
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <title>{title}</title>
    </head>
    <body>
        <a class="skip-link" href="#main-content">{skipToContent}</a>
        <slot />
        <script>
            import "../scripts/initCopyButtons.ts";
            import "../scripts/initMobileInstallBar.ts";
        </script>
    </body>
</html>
