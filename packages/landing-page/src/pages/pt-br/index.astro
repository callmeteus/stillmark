---
import CommandReference from "../../components/landing/CommandReference.astro";
import AgentInstallTabs from "../../components/landing/AgentInstallTabs.astro";
import HeroInstallTabs from "../../components/landing/HeroInstallTabs.astro";
import CompanionSection from "../../components/landing/CompanionSection.astro";
import HowItWorksCards from "../../components/landing/HowItWorksCards.astro";
import MobileInstallBar from "../../components/landing/MobileInstallBar.astro";
import SiteHeader from "../../components/landing/SiteHeader.astro";
import WorkflowSteps from "../../components/landing/WorkflowSteps.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SiteLinks } from "../../config/SiteLinks";
import { ptBR } from "../../i18n/pt-BR";
import { buildInstallPrompt } from "../../utils/BuildInstallPrompt";

const t = ptBR;
const lang = "pt-BR";
const installGuideUrl = SiteLinks.resolveInstallGuideUrl(lang);
const installPrompt = buildInstallPrompt(t.hero.installPromptTemplate, installGuideUrl);
---

<BaseLayout
    title={t.meta.title}
    description={t.meta.description}
    lang={lang}
    skipToContent={t.nav.skipToContent}
>
    <SiteHeader
        nav={t.nav}
        logoHref="/pt-br/"
        langSwitchHref="/"
        langSwitchLabel="EN"
        navAriaLabel="Principal"
    />

    <main id="main-content" class="container page-main" tabindex="-1">
        <section class="grid-hero hero-trail hero-peak" aria-labelledby="hero-title">
            <div class="hero-copy">
                <h1 id="hero-title" class="hero-title">{t.hero.title}</h1>
                <p class="muted hero-subtitle">{t.hero.subtitle}</p>
                <p class="hero-cta">
                    <a class="hero-cta-link" href="#get-started">{t.nav.getStarted}</a>
                </p>
            </div>
            <div id="hero-install" class="hero-install-anchor">
                <HeroInstallTabs
                    agentLabel={t.hero.installLabel}
                    cliLabel={t.hero.installCliLabel}
                    tabGroupLabel={t.hero.installTabGroupLabel}
                    modeAgentLabel={t.hero.installModeAgentLabel}
                    modeCliLabel={t.hero.installModeCliLabel}
                    agentPrompt={installPrompt}
                    cliCommand={t.hero.cliInstallCommand}
                    copyLabel={t.copy.copyShort}
                    copiedLabel={t.copy.copied}
                    failedLabel={t.copy.failed}
                    agentReadyLabel={t.copy.readyInTerminal}
                    cliReadyLabel={t.copy.readyInTerminal}
                    agentManualHint={t.copy.manualHint}
                    cliManualHint={t.hero.cliInstallHint}
                />
            </div>
        </section>

        <section id="get-started" class="card section-card workflow-panel">
            <h2>{t.quickStart.title}</h2>
            <WorkflowSteps steps={t.quickStart.steps} />
        </section>

        <section class="card section-card how-it-works-panel">
            <h2>{t.howItWorks.title}</h2>
            <HowItWorksCards lead={t.howItWorks.lead} items={t.howItWorks.items} />
        </section>

        <CompanionSection id="coverage" content={t.coverage} />
        <CompanionSection id="design" content={t.design} />
        <CompanionSection id="planning" content={t.planning} />
        <CompanionSection id="workspace" content={t.workspace} />

        <section class="page-section features-section">
            <h2>{t.features.title}</h2>
            <div class="features">
                {
                    t.features.items.map((item) => (
                        <article class="card">
                            <h3>{item.title}</h3>
                            <p class="muted feature-body">{item.body}</p>
                        </article>
                    ))
                }
            </div>
        </section>

        <section id="agents" class="page-section workflow-step-section">
            <div class="section-heading-row">
                <span class="step-badge">{t.agents.stepLabel}</span>
                <h2>{t.agents.title}</h2>
            </div>
            <p class="muted section-lead">{t.agents.intro}</p>
            <AgentInstallTabs
                items={t.agents.items}
                tabGroupLabel={t.agents.tabGroupLabel}
                copyLabel={t.copy.copyShort}
                copiedLabel={t.copy.copied}
                failedLabel={t.copy.failed}
                readyLabel={t.copy.readyInTerminal}
            />
            <p class="copy-manual-hint muted agents-copy-hint">{t.copy.manualHint}</p>
        </section>

        <section id="commands" class="page-section">
            <h2>{t.commands.title}</h2>
            <CommandReference
                commandHeader={t.commands.tableCommand}
                descriptionHeader={t.commands.tableDescription}
                modeConsoleLabel={t.commands.modeConsoleLabel}
                modeAgentLabel={t.commands.modeAgentLabel}
                modeGroupLabel={t.commands.modeGroupLabel}
                rows={t.commands.rows}
                agentOnlyRows={t.commands.agentOnlyRows}
            />
        </section>
    </main>

    <footer class="site-footer muted">
        {t.footer.tagline}
    </footer>

    <MobileInstallBar
        command={installPrompt}
        copyLabel={t.copy.copyShort}
        copiedLabel={t.copy.copied}
        failedLabel={t.copy.failed}
        readyLabel={t.copy.readyInTerminal}
        barLabel={t.hero.installLabel}
    />
</BaseLayout>
