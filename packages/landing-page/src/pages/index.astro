---
import CommandReference from "../components/landing/CommandReference.astro";
import AgentInstallTabs from "../components/landing/AgentInstallTabs.astro";
import HeroInstallTabs from "../components/landing/HeroInstallTabs.astro";
import MobileInstallBar from "../components/landing/MobileInstallBar.astro";
import SiteHeader from "../components/landing/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SiteLinks } from "../config/SiteLinks";
import { createLocaleBundle } from "../i18n/LocaleBundle";
import type { LocaleId } from "../i18n/LocaleIds";
import { enUS } from "../i18n/en-US";
import { buildInstallPrompt } from "../utils/BuildInstallPrompt";

const t = enUS;
const lang = "en-US";
const installUrls: Record<LocaleId, string> = {
    "en-US": SiteLinks.resolveInstallGuideUrl("en-US"),
    "pt-BR": SiteLinks.resolveInstallGuideUrl("pt-BR")
};
const localeBundle = createLocaleBundle(installUrls);
const installPrompt = buildInstallPrompt(t.hero.installPromptTemplate, installUrls[lang]);
---

<BaseLayout
    title={t.meta.title}
    description={t.meta.description}
    lang={lang}
    skipToContent={t.nav.skipToContent}
>
    <SiteHeader nav={t.nav} logoHref="/stillmark/" navAriaLabel="Primary" />

    <main id="main-content" class="container page-main" tabindex="-1">
        <section class="grid-hero hero-trail hero-peak" aria-labelledby="hero-title">
            <div class="hero-copy">
                <h1 id="hero-title" class="hero-title" data-i18n="hero.title">{t.hero.title}</h1>
                <p class="muted hero-subtitle" data-i18n="hero.subtitle">{t.hero.subtitle}</p>
                <p class="hero-cta">
                    <a class="hero-cta-link" href="#get-started" data-i18n="nav.getStarted">{t.nav.getStarted}</a>
                </p>
            </div>
            <div id="hero-install" class="hero-install-anchor">
                <HeroInstallTabs
                    agentLabel={t.hero.installLabel}
                    cliLabel={t.hero.installCliLabel}
                    tabGroupLabel={t.hero.installTabGroupLabel}
                    modeAgentLabel={t.hero.installModeAgentLabel}
                    modeCliLabel={t.hero.installModeCliLabel}
                    agentPrompt={installPrompt}
                    cliCommand={t.hero.cliInstallCommand}
                    copyLabel={t.copy.copyShort}
                    copiedLabel={t.copy.copied}
                    failedLabel={t.copy.failed}
                    agentReadyLabel={t.copy.readyInTerminal}
                    cliReadyLabel={t.copy.readyInTerminal}
                    agentManualHint={t.copy.manualHint}
                    cliManualHint={t.hero.cliInstallHint}
                />
            </div>
        </section>

        <section id="get-started" class="card section-card workflow-panel">
            <h2 data-i18n="quickStart.title">{t.quickStart.title}</h2>
            <ol class="workflow-steps" data-i18n-mount="workflow-steps"></ol>
        </section>

        <section class="card section-card how-it-works-panel">
            <h2 data-i18n="howItWorks.title">{t.howItWorks.title}</h2>
            <div data-i18n-mount="how-it-works"></div>
        </section>

        <section id="coverage" class="page-section companion-section" data-i18n-mount="companion-coverage"></section>
        <section id="design" class="page-section companion-section" data-i18n-mount="companion-design"></section>
        <section id="planning" class="page-section companion-section" data-i18n-mount="companion-planning"></section>
        <section id="workspace" class="page-section companion-section" data-i18n-mount="companion-workspace"></section>

        <section class="page-section features-section">
            <h2 data-i18n="features.title">{t.features.title}</h2>
            <div class="features" data-i18n-mount="features"></div>
        </section>

        <section id="agents" class="page-section workflow-step-section">
            <div class="section-heading-row">
                <span class="step-badge" data-i18n="agents.stepLabel">{t.agents.stepLabel}</span>
                <h2 data-i18n="agents.title">{t.agents.title}</h2>
            </div>
            <p class="muted section-lead" data-i18n="agents.intro">{t.agents.intro}</p>
            <AgentInstallTabs
                items={t.agents.items}
                tabGroupLabel={t.agents.tabGroupLabel}
                copyLabel={t.copy.copyShort}
                copiedLabel={t.copy.copied}
                failedLabel={t.copy.failed}
                readyLabel={t.copy.readyInTerminal}
            />
            <p class="copy-manual-hint muted agents-copy-hint" data-i18n="copy.manualHint">{t.copy.manualHint}</p>
        </section>

        <section id="commands" class="page-section">
            <h2 data-i18n="commands.title">{t.commands.title}</h2>
            <CommandReference
                commandHeader={t.commands.tableCommand}
                descriptionHeader={t.commands.tableDescription}
                modeConsoleLabel={t.commands.modeConsoleLabel}
                modeAgentLabel={t.commands.modeAgentLabel}
                modeGroupLabel={t.commands.modeGroupLabel}
                rows={t.commands.rows}
                agentOnlyRows={t.commands.agentOnlyRows}
            />
        </section>
    </main>

    <footer class="site-footer muted">
        <span data-i18n="footer.tagline">{t.footer.tagline}</span>
    </footer>

    <MobileInstallBar
        command={installPrompt}
        copyLabel={t.copy.copyShort}
        copiedLabel={t.copy.copied}
        failedLabel={t.copy.failed}
        readyLabel={t.copy.readyInTerminal}
        barLabel={t.hero.installLabel}
    />

    <script define:vars={{ localeBundle }}>
        window.__STILLMARK_LOCALE__ = localeBundle;
    </script>
</BaseLayout>
