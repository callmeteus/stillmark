---
import ActivityLog from "../components/home/ActivityLog.astro";
import DesignShowcase from "../components/home/DesignShowcase.astro";
import FeatureGrid from "../components/home/FeatureGrid.astro";
import HomeHero from "../components/home/HomeHero.astro";
import InstallSteps from "../components/home/InstallSteps.astro";
import TopicPicker from "../components/home/TopicPicker.astro";
import WhyCommand from "../components/home/WhyCommand.astro";
import { createLocaleBundle, SiteMessagesByLocale } from "../i18n/LocaleBundle";
import { enUS } from "../i18n/en-US";
import { TopicGroup, TopicId, Topics } from "../i18n/topics";
import SiteLayout from "../layouts/SiteLayout.astro";

const PickerTopics = [
    ...Topics.filter((topic) => topic.group !== TopicGroup.START),
    ...Topics.filter((topic) => topic.id === TopicId.SETTINGS)
];

const bundle = createLocaleBundle((locale) => ({
    meta: SiteMessagesByLocale[locale].home.meta,
    page: {
        ...SiteMessagesByLocale[locale].home,
        picks: PickerTopics.map((topic) => ({
            contrast: topic.copy[locale].contrast,
            say: topic.copy[locale].examples[0].say
        }))
    }
}));

const t = enUS.home;
const ui = enUS.ui;
---

<SiteLayout bundle={bundle}>
    <main id="main-content" class="home" tabindex="-1">
        <HomeHero hero={t.hero} />
        <DesignShowcase design={t.design} ui={ui} />
        <TopicPicker topics={PickerTopics} picker={t.picker} ui={ui} />
        <WhyCommand why={t.why} />
        <FeatureGrid features={t.features} />
        <ActivityLog log={t.log} />
        <InstallSteps install={t.install} ui={ui} />
    </main>
</SiteLayout>
