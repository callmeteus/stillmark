---
/**
 * Stillmark mark: an S from two interleaved chevron halves, offset vertically, each with a short bar beside it.
 */
interface Props {
    class?: string;
}

const { class: className } = Astro.props;
---

<svg class={className} viewBox="3 5 41 57" aria-hidden="true" focusable="false">
    <g fill="none" stroke="currentColor" stroke-width="7" stroke-linejoin="miter" stroke-linecap="butt">
        <path d="M26.5 8L9 17.5V34.5L25 43" />
        <path d="M21.5 25L40.5 34V50L21 59.5" />
    </g>
    <rect x="27.5" y="14" width="14.5" height="7" fill="currentColor" />
    <rect x="5" y="46" width="14.5" height="7" fill="currentColor" />
</svg>
