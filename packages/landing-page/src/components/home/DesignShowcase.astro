---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import { SiteLinks } from "../../config/SiteLinks";
import type { SiteMessages } from "../../i18n/en-US";
import CompareSlider from "../site/CompareSlider.astro";
import PricingMock from "./PricingMock.astro";

/**
 * Design demo right under the hero: the request, then the same screen before and after the fix
 * in a draggable slider.
 */
interface Props {
    design: SiteMessages["home"]["design"];
    ui: SiteMessages["ui"];
}

const { design, ui } = Astro.props;
---

<section class="home-section showcase" aria-labelledby="design-title">
    <h2 id="design-title" class="section-title" data-i18n="page.design.title">{design.title}</h2>
    <p class="section-lead" data-i18n="page.design.lead">{design.lead}</p>

    <p class="showcase-say">
        <span class="example-slash">/stillmark design</span>
        <span data-i18n="page.design.say">{design.say}</span>
    </p>

    <CompareSlider labels={ui.compare} class="compare-screen">
        <PricingMock slot="before" mock={design.mock} variant="before" />
        <PricingMock slot="after" mock={design.mock} variant="after" />
    </CompareSlider>

    <a class="text-link showcase-link" href={SiteLinks.topicUrl("design")}>
        <span data-i18n="page.design.more">{design.more}</span>
        <ArrowRight size={16} stroke-width={1.8} aria-hidden="true" />
    </a>
</section>
