---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import { SiteLinks } from "../../config/SiteLinks";
import type { SiteMessages } from "../../i18n/en-US";

/**
 * The files Stillmark keeps current, plus the guard that refuses secrets and duplicates.
 * Each card links to the docs topic that explains it.
 */
interface Props {
    
    features: SiteMessages["home"]["features"];
}

const { features } = Astro.props;
---

<section class="home-section" aria-labelledby="features-title">
    <h2 id="features-title" class="section-title" data-i18n="page.features.title">{features.title}</h2>

    <ul class="feature-grid">
        {
            features.items.map((item, index) => (
                <li>
                    <a class="feature-card" href={SiteLinks.topicUrl(item.slug)}>
                        {item.file ? <code class="feature-file">{item.file}</code> : null}
                        <h3 class="feature-title" data-i18n={`page.features.items.${index}.title`}>{item.title}</h3>
                        <p class="feature-body" data-i18n={`page.features.items.${index}.body`}>{item.body}</p>
                        <ArrowRight size={16} stroke-width={1.8} aria-hidden="true" class="feature-arrow" />
                    </a>
                </li>
            ))
        }
    </ul>
</section>
