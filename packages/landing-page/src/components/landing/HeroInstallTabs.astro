---
import { randomUUID } from "node:crypto";

interface Props {
    agentLabel: string;
    cliLabel: string;
    tabGroupLabel: string;
    modeAgentLabel: string;
    modeCliLabel: string;
    scopeGroupLabel: string;
    scopeProjectLabel: string;
    scopeGlobalLabel: string;
    agentPrompt: string;
    globalAgentPrompt: string;
    cliCommand: string;
    globalCliCommand: string;
    copyLabel: string;
    copiedLabel: string;
    failedLabel: string;
    agentReadyLabel: string;
    cliReadyLabel: string;
    agentManualHint: string;
    cliManualHint: string;
    globalCliManualHint: string;
}

const {
    agentLabel,
    cliLabel,
    tabGroupLabel,
    modeAgentLabel,
    modeCliLabel,
    scopeGroupLabel,
    scopeProjectLabel,
    scopeGlobalLabel,
    agentPrompt,
    globalAgentPrompt,
    cliCommand,
    globalCliCommand,
    copyLabel,
    copiedLabel,
    failedLabel,
    agentReadyLabel,
    cliReadyLabel,
    agentManualHint,
    cliManualHint,
    globalCliManualHint
} = Astro.props;

const agentCommandId = `hero-install-agent-${randomUUID()}`;
const agentGlobalCommandId = `hero-install-agent-global-${randomUUID()}`;
const cliCommandId = `hero-install-cli-${randomUUID()}`;
const cliGlobalCommandId = `hero-install-cli-global-${randomUUID()}`;
---

<div class="title-block" data-hero-install-tabs data-mode="agent" data-scope="project">
    <div class="title-block-head">
        <p class="title-block-label">
            <span class="title-block-label-agent" data-i18n="hero.installLabel">{agentLabel}</span>
            <span class="title-block-label-cli" data-i18n="hero.installCliLabel">{cliLabel}</span>
        </p>
        <div
            class="segmented"
            role="tablist"
            aria-label={tabGroupLabel}
            data-i18n-aria-label="hero.installTabGroupLabel"
        >
            <button
                type="button"
                class="segmented-btn"
                role="tab"
                id="hero-install-tab-agent"
                aria-selected="true"
                aria-controls="hero-install-panel-agent"
                tabindex="0"
                data-hero-install-mode="agent"
                data-i18n="hero.installModeAgentLabel"
            >
                {modeAgentLabel}
            </button>
            <button
                type="button"
                class="segmented-btn"
                role="tab"
                id="hero-install-tab-cli"
                aria-selected="false"
                aria-controls="hero-install-panel-cli"
                tabindex="-1"
                data-hero-install-mode="cli"
                data-i18n="hero.installModeCliLabel"
            >
                {modeCliLabel}
            </button>
        </div>
    </div>

    <div
        class="segmented title-block-scope"
        role="group"
        aria-label={scopeGroupLabel}
        data-i18n-aria-label="hero.installScopeGroupLabel"
    >
        <button
            type="button"
            class="segmented-btn"
            aria-pressed="true"
            data-hero-install-scope="project"
            data-i18n="hero.installScopeProjectLabel"
        >
            {scopeProjectLabel}
        </button>
        <button
            type="button"
            class="segmented-btn"
            aria-pressed="false"
            data-hero-install-scope="global"
            data-i18n="hero.installScopeGlobalLabel"
        >
            {scopeGlobalLabel}
        </button>
    </div>

    <div
        class="title-block-panel"
        id="hero-install-panel-agent"
        role="tabpanel"
        aria-labelledby="hero-install-tab-agent"
        data-hero-install-panel="agent"
        data-copy-root
    >
        <code id={agentCommandId} class="prompt-code break-code" tabindex="0" data-hero-agent-prompt data-scope-variant="project">
            {agentPrompt}
        </code>
        <code
            id={agentGlobalCommandId}
            class="prompt-code break-code"
            tabindex="0"
            data-hero-agent-prompt="global"
            data-scope-variant="global"
        >
            {globalAgentPrompt}
        </code>
        <div class="title-block-actions">
            <p class="title-block-hint" data-i18n="copy.manualHint">{agentManualHint}</p>
            <button
                type="button"
                class="btn btn-copy"
                data-copy-target={agentCommandId}
                data-copy-target-project={agentCommandId}
                data-copy-target-global={agentGlobalCommandId}
                data-copy-label={copyLabel}
                data-copied-label={copiedLabel}
                data-failed-label={failedLabel}
                data-ready-label={agentReadyLabel}
                aria-label={`${copyLabel}: ${agentPrompt}`}
            >
                {copyLabel}
            </button>
        </div>
        <p class="copy-status" role="status" aria-live="polite"></p>
    </div>

    <div
        class="title-block-panel"
        id="hero-install-panel-cli"
        role="tabpanel"
        aria-labelledby="hero-install-tab-cli"
        hidden
        data-hero-install-panel="cli"
        data-copy-root
    >
        <code
            id={cliCommandId}
            class="prompt-code prompt-code-cli break-code"
            tabindex="0"
            data-hero-cli-command
            data-scope-variant="project"
        >
            {cliCommand}
        </code>
        <code
            id={cliGlobalCommandId}
            class="prompt-code prompt-code-cli break-code"
            tabindex="0"
            data-hero-cli-command="global"
            data-scope-variant="global"
        >
            {globalCliCommand}
        </code>
        <div class="title-block-actions">
            <p class="title-block-hint" data-i18n="hero.cliInstallHint" data-scope-variant="project">{cliManualHint}</p>
            <p class="title-block-hint" data-i18n="hero.cliInstallGlobalHint" data-scope-variant="global">
                {globalCliManualHint}
            </p>
            <button
                type="button"
                class="btn btn-copy"
                data-copy-target={cliCommandId}
                data-copy-target-project={cliCommandId}
                data-copy-target-global={cliGlobalCommandId}
                data-copy-label={copyLabel}
                data-copied-label={copiedLabel}
                data-failed-label={failedLabel}
                data-ready-label={cliReadyLabel}
                aria-label={`${copyLabel}: ${cliCommand}`}
            >
                {copyLabel}
            </button>
        </div>
        <p class="copy-status" role="status" aria-live="polite"></p>
    </div>
</div>

<script>
    type InstallScope = "project" | "global";

    function initHeroInstallTabs(root: HTMLElement) {
        const tabs = root.querySelectorAll<HTMLButtonElement>("[data-hero-install-mode]");
        const panels = root.querySelectorAll<HTMLElement>("[data-hero-install-panel]");
        const scopeButtons = root.querySelectorAll<HTMLButtonElement>("[data-hero-install-scope]");

        function setMode(mode: "agent" | "cli") {
            root.dataset.mode = mode;

            for (const tab of tabs) {
                const selected = tab.dataset.heroInstallMode === mode;

                tab.setAttribute("aria-selected", selected ? "true" : "false");
                tab.tabIndex = selected ? 0 : -1;
            }

            for (const panel of panels) {
                const show = panel.dataset.heroInstallPanel === mode;

                if (show) {
                    panel.removeAttribute("hidden");
                } else {
                    panel.setAttribute("hidden", "");
                }
            }
        }

        function setScope(scope: InstallScope) {
            root.dataset.scope = scope;

            for (const button of scopeButtons) {
                button.setAttribute("aria-pressed", button.dataset.heroInstallScope === scope ? "true" : "false");
            }

            for (const copy of root.querySelectorAll<HTMLButtonElement>("[data-copy-target-project]")) {
                const targetId = scope === "global" ? copy.dataset.copyTargetGlobal : copy.dataset.copyTargetProject;
                const target = targetId ? document.getElementById(targetId) : null;

                if (targetId) {
                    copy.setAttribute("data-copy-target", targetId);
                }

                if (target?.textContent) {
                    copy.setAttribute("aria-label", `${copy.dataset.copyLabel ?? ""}: ${target.textContent.trim()}`);
                }
            }
        }

        for (const button of scopeButtons) {
            button.addEventListener("click", () => {
                const scope = button.dataset.heroInstallScope;

                if (scope === "project" || scope === "global") {
                    setScope(scope);
                }
            });
        }

        for (const tab of tabs) {
            tab.addEventListener("click", () => {
                const mode = tab.dataset.heroInstallMode;

                if (mode === "agent" || mode === "cli") {
                    setMode(mode);
                }
            });

            tab.addEventListener("keydown", (event) => {
                if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") {
                    return;
                }

                const list = [...tabs];
                const currentIndex = list.indexOf(tab);

                if (currentIndex < 0) {
                    return;
                }

                const delta = event.key === "ArrowRight" ? 1 : -1;
                const next = list[(currentIndex + delta + list.length) % list.length];
                const mode = next.dataset.heroInstallMode;

                if (mode === "agent" || mode === "cli") {
                    event.preventDefault();
                    next.focus();
                    setMode(mode);
                }
            });
        }
    }

    for (const root of document.querySelectorAll<HTMLElement>("[data-hero-install-tabs]")) {
        initHeroInstallTabs(root);
    }
</script>
