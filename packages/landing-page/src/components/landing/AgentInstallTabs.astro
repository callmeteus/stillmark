---
import { randomUUID } from "node:crypto";

interface AgentItem {
    label: string;
    command: string;
}

interface Props {
    items: AgentItem[];
    tabGroupLabel: string;
    copyLabel: string;
    copiedLabel: string;
    failedLabel: string;
    readyLabel: string;
}

const { items, tabGroupLabel, copyLabel, copiedLabel, failedLabel, readyLabel } = Astro.props;

/**
 * Stable tab id from agent display name.
 */
function agentTabId(label: string): string {
    return label.toLowerCase();
}

const panels = items.map((item) => ({
    ...item,
    id: agentTabId(item.label),
    commandId: `agent-install-${agentTabId(item.label)}-${randomUUID()}`
}));
---

<div class="agent-install-tabs" data-agent-install-tabs>
    <div
        class="segmented agent-install-tablist"
        role="tablist"
        aria-label={tabGroupLabel}
        data-i18n-aria-label="agents.tabGroupLabel"
    >
        {
            panels.map((panel, index) => (
                <button
                    type="button"
                    class="segmented-btn"
                    role="tab"
                    id={`agent-tab-${panel.id}`}
                    aria-selected={index === 0 ? "true" : "false"}
                    aria-controls={`agent-panel-${panel.id}`}
                    tabindex={index === 0 ? 0 : -1}
                    data-agent-tab={panel.id}
                >
                    {panel.label}
                </button>
            ))
        }
    </div>
    {
        panels.map((panel, index) => (
            <div
                class="agent-install-panel"
                role="tabpanel"
                id={`agent-panel-${panel.id}`}
                aria-labelledby={`agent-tab-${panel.id}`}
                hidden={index !== 0 ? true : undefined}
                data-agent-panel={panel.id}
                data-copy-root
            >
                <div class="install-row">
                    <code id={panel.commandId} class="install-code break-code" tabindex="0">{panel.command}</code>
                    <button
                        type="button"
                        class="btn btn-copy btn-quiet"
                        data-copy-target={panel.commandId}
                        data-copy-label={copyLabel}
                        data-copied-label={copiedLabel}
                        data-failed-label={failedLabel}
                        data-ready-label={readyLabel}
                        aria-label={`${copyLabel}: ${panel.command}`}
                    >
                        {copyLabel}
                    </button>
                </div>
                <p class="copy-status" role="status" aria-live="polite"></p>
            </div>
        ))
    }
</div>

<script>
    function initAgentInstallTabs(root: HTMLElement) {
        const tabs = root.querySelectorAll<HTMLButtonElement>("[data-agent-tab]");
        const panels = root.querySelectorAll<HTMLElement>("[data-agent-panel]");

        function activate(tabId: string) {
            for (const tab of tabs) {
                const selected = tab.dataset.agentTab === tabId;

                tab.setAttribute("aria-selected", selected ? "true" : "false");
                tab.tabIndex = selected ? 0 : -1;
            }

            for (const panel of panels) {
                const show = panel.dataset.agentPanel === tabId;

                if (show) {
                    panel.removeAttribute("hidden");
                } else {
                    panel.setAttribute("hidden", "");
                }
            }
        }

        for (const tab of tabs) {
            tab.addEventListener("click", () => {
                const tabId = tab.dataset.agentTab;

                if (tabId) {
                    activate(tabId);
                }
            });

            tab.addEventListener("keydown", (event) => {
                if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") {
                    return;
                }

                const list = [...tabs];
                const currentIndex = list.indexOf(tab);

                if (currentIndex < 0) {
                    return;
                }

                const delta = event.key === "ArrowRight" ? 1 : -1;
                const next = list[(currentIndex + delta + list.length) % list.length];
                const tabId = next.dataset.agentTab;

                if (tabId) {
                    event.preventDefault();
                    next.focus();
                    activate(tabId);
                }
            });
        }
    }

    for (const root of document.querySelectorAll<HTMLElement>("[data-agent-install-tabs]")) {
        initAgentInstallTabs(root);
    }
</script>
