---
/**
 * Revision delta triangle used as the Stillmark mark and on revised lines.
 */
interface Props {
    class?: string;
    label?: string;
}

const { class: className, label } = Astro.props;
---

<span class:list={["delta-mark", className]} aria-hidden="true">
    <svg viewBox="0 0 24 21" focusable="false">
        <path d="M12 1.5 22.5 19.5H1.5Z" />
    </svg>
    {label ? <span class="delta-mark-label">{label}</span> : null}
</span>
