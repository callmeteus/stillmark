---
import { randomUUID } from "node:crypto";

interface Props {
    label: string;
    command: string;
    copyLabel: string;
    copiedLabel: string;
    failedLabel: string;
    readyLabel: string;
    manualHint: string;
}

const { label, command, copyLabel, copiedLabel, failedLabel, readyLabel, manualHint } = Astro.props;
const commandId = `install-${randomUUID()}`;
---

<div class="install-panel" data-copy-root>
    <p class="muted install-card-label">{label}</p>
    <div class="install-prompt-shell">
        <code id={commandId} class="install-code break-code" tabindex="0">{command}</code>
        <button
            type="button"
            class="btn btn-copy btn-copy-embedded"
            data-copy-target={commandId}
            data-copy-label={copyLabel}
            data-copied-label={copiedLabel}
            data-failed-label={failedLabel}
            data-ready-label={readyLabel}
            aria-label={`${copyLabel}: ${command}`}
        >
            {copyLabel}
        </button>
    </div>
    <p class="copy-status muted" role="status" aria-live="polite"></p>
    <p class="copy-manual-hint muted">{manualHint}</p>
</div>
