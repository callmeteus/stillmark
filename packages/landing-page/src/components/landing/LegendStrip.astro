---
import type { Messages } from "../../i18n/en-US";
import LineSample from "./LineSample.astro";

interface Props {
    content: Messages["howItWorks"];
}

const { content } = Astro.props;
---

<div class="legend">
    <ol class="legend-sheets">
        {
            content.items.map((item, index) => {
                const local = item.file.startsWith(".stillmark/");

                return (
                    <li class:list={["legend-sheet", { "is-local": local }]}>
                        <LineSample local={local} class="legend-sheet-rule" />
                        <h3 data-i18n={`howItWorks.items.${index}.title`}>{item.title}</h3>
                        <p class="legend-sheet-file">
                            <code>{item.file}</code>
                        </p>
                        <p class="legend-sheet-badge" data-i18n={`howItWorks.items.${index}.badge`}>{item.badge}</p>
                        <p class="legend-sheet-body" data-i18n={`howItWorks.items.${index}.body`}>{item.body}</p>
                    </li>
                );
            })
        }
    </ol>
</div>
