---
/**
 * Drawing line-type sample: solid for shared files, dashed hidden line for local files.
 */
interface Props {
    local: boolean;
    class?: string;
}

const { local, class: className } = Astro.props;
---

<svg
    class:list={["line-sample", { "is-local": local }, className]}
    aria-hidden="true"
    focusable="false"
>
    <line x1="0" y1="4" x2="100%" y2="4" />
</svg>
