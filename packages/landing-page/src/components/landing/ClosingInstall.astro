---
import type { Messages } from "../../i18n/en-US";

interface Props {
    close: Messages["close"];
    command: string;
    copy: Messages["copy"];
}

const { close, command, copy } = Astro.props;
const commandId = "closing-install-command";
---

<section class="page-section closing" aria-labelledby="closing-title">
    <div class="closing-copy">
        <h2 id="closing-title" data-i18n="close.title">{close.title}</h2>
        <p class="section-lead" data-i18n="close.body">{close.body}</p>
    </div>
    <div class="closing-action" data-copy-root>
        <code id={commandId} class="prompt-code prompt-code-cli" tabindex="0" data-hero-cli-command>{command}</code>
        <div class="closing-row">
            <button
                type="button"
                class="btn btn-copy"
                data-copy-target={commandId}
                data-copy-label={copy.copyShort}
                data-copied-label={copy.copied}
                data-failed-label={copy.failed}
                data-ready-label={copy.readyInTerminal}
                aria-label={`${copy.copyShort}: ${command}`}
            >
                {copy.copyShort}
            </button>
            <a href="#hero-install" data-i18n="close.agentLink">{close.agentLink}</a>
        </div>
        <p class="copy-status" role="status" aria-live="polite"></p>
    </div>
</section>
