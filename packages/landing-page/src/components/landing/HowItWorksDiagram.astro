---
interface Props {
    actorLabel: string;
    publicLabel: string;
    privateLabel: string;
    coverageSkill: string;
    ariaLabel: string;
}

const { actorLabel, publicLabel, privateLabel, coverageSkill, ariaLabel } = Astro.props;
---

<figure class="flow-diagram code-block diagram-block" aria-label={ariaLabel}>
    <pre class="flow-diagram-pre"><code><span class="flow-actor">{actorLabel}</span>
    |
    v
<span class="flow-cli">stillmark classify / add / move / coverage</span>  <span class="flow-flag">(--json)</span>
    |
    <span class="flow-branch flow-branch-public">+--&gt; ROADMAP.md          ({publicLabel})</span>
    |
    <span class="flow-branch flow-branch-private">+--&gt; .stillmark/plans/TASK_PLAN.md  ({privateLabel})</span>
    |
    <span class="flow-branch flow-branch-public">+--&gt; COVERAGE.md         ({publicLabel})  {coverageSkill}</span></code></pre>
</figure>
