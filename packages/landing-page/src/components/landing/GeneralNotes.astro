---
import type { Messages } from "../../i18n/en-US";
import { inlineCodeHtml } from "../../utils/InlineCode";

interface Props {
    steps: Messages["quickStart"]["steps"];
}

const { steps } = Astro.props;
---

<ol class="general-notes">
    {
        steps.map((step, index) => (
            <li class="general-note" id={index === 1 ? "agents" : undefined}>
                <span class="general-note-index" aria-hidden="true">{index + 1}</span>
                <h3 data-i18n={`quickStart.steps.${index}.title`}>{step.title}</h3>
                <p data-i18n-rich={`quickStart.steps.${index}.body`} set:html={inlineCodeHtml(step.body)} />
                {index === 1 ? <slot /> : null}
            </li>
        ))
    }
</ol>
