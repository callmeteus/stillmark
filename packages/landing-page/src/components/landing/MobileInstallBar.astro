---
import { randomUUID } from "node:crypto";

interface Props {
    command: string;
    copyLabel: string;
    copiedLabel: string;
    failedLabel: string;
    readyLabel: string;
    barLabel: string;
}

const { command, copyLabel, copiedLabel, failedLabel, readyLabel, barLabel } = Astro.props;
const commandId = `mobile-install-${randomUUID()}`;
---

<div class="mobile-install-bar" data-mobile-install-bar hidden data-copy-root>
    <p class="mobile-install-bar-label" data-i18n="hero.installLabel">{barLabel}</p>
    <div class="mobile-install-bar-row">
        <code id={commandId} class="mobile-install-code break-code" data-mobile-install-command>{command}</code>
        <button
            type="button"
            class="btn btn-copy mobile-install-copy"
            data-copy-target={commandId}
            data-copy-label={copyLabel}
            data-copied-label={copiedLabel}
            data-failed-label={failedLabel}
            data-ready-label={readyLabel}
            aria-label={`${copyLabel}: ${command}`}
        >
            {copyLabel}
        </button>
    </div>
    <p class="copy-status muted mobile-install-status" role="status" aria-live="polite"></p>
</div>
