---
import type { Messages } from "../../i18n/en-US";
import DeltaMark from "./DeltaMark.astro";

interface Props {
    demo: Messages["hero"]["demo"];
}

const { demo } = Astro.props;

/**
 * Sheets in revision order: the last line of each sheet is the revision that lands on it.
 */
const sheets = [
    { key: "roadmap", file: "ROADMAP.md", local: false, lines: demo.roadmap },
    { key: "plan", file: "TASK_PLAN.md", local: true, lines: demo.plan },
    { key: "coverage", file: "COVERAGE.md", local: false, lines: demo.coverage }
] as const;
---

<div class="drawing">
    <ol class="request-list">
        {
            demo.requests.map((request, index) => (
                <li class:list={["request", { "is-active": index === 0 }]} data-demo-step={index}>
                    <p class="request-say">
                        <span class="request-label" data-i18n="hero.demo.requestLabel">{demo.requestLabel}</span>
                        <q data-i18n={`hero.demo.requests.${index}.say`}>{request.say}</q>
                    </p>
                    <p class="request-run">
                        <span class="request-label" data-i18n="hero.demo.commandLabel">{demo.commandLabel}</span>
                        <code data-i18n={`hero.demo.requests.${index}.run`}>{request.run}</code>
                    </p>
                </li>
            ))
        }
    </ol>

    <div class="drawing-sheets">
        {
            sheets.map((sheet, sheetIndex) => (
                <figure class:list={["file-sheet", { "is-local": sheet.local }]}>
                    <figcaption class="file-sheet-head">
                        <span class="file-name">{sheet.file}</span>
                        <span
                            class="file-tag"
                            data-i18n={sheet.local ? "hero.demo.localTag" : "hero.demo.sharedTag"}
                        >
                            {sheet.local ? demo.localTag : demo.sharedTag}
                        </span>
                    </figcaption>
                    <ol class="file-lines">
                        {
                            sheet.lines.map((line, lineIndex) => {
                                const isRevision = lineIndex === sheet.lines.length - 1;

                                return (
                                    <li
                                        class:list={["file-line", { "is-heading": line.startsWith("#") }]}
                                        data-rev-line={isRevision ? sheetIndex + 1 : undefined}
                                    >
                                        <span
                                            class="file-line-text"
                                            data-i18n={`hero.demo.${sheet.key}.${lineIndex}`}
                                        >
                                            {line}
                                        </span>
                                        {isRevision ? <DeltaMark class="file-line-delta" label={String(sheetIndex + 1)} /> : null}
                                    </li>
                                );
                            })
                        }
                    </ol>
                </figure>
            ))
        }
    </div>
</div>
