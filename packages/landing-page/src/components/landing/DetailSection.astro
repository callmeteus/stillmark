---
import type { Messages } from "../../i18n/en-US";
import { inlineCodeHtml } from "../../utils/InlineCode";
import DeltaMark from "./DeltaMark.astro";

type DetailKey = "planning" | "coverage" | "design" | "workspace";

interface SampleFigure {
    file: string;
    local: boolean;
    lines: string[];
    /** Line that keeps the revision cloud from the hero demo, with its revision number. */
    revised?: { line: number; rev: number };
}

interface Props {
    sectionKey: DetailKey;
    sheetId: string;
    content: Messages[DetailKey];
    sample?: SampleFigure;
    tree?: Messages["workspace"]["tree"];
    /** Puts the figure before the notes on wide screens. */
    flip?: boolean;
}

const { sectionKey, sheetId, content, sample, tree, flip = false } = Astro.props;
const headingId = `${sectionKey}-title`;
const hasFigure = Boolean(sample || tree);
---

<section id={sectionKey} class="page-section detail" aria-labelledby={headingId}>
    <header class="section-head">
        <h2 id={headingId} data-i18n={`${sectionKey}.title`}>{content.title}</h2>
        <p class="section-lead" data-i18n={`${sectionKey}.lead`}>{content.lead}</p>
    </header>

    <div class:list={["detail-body", { "has-figure": hasFigure, "is-flipped": flip }]}>
        <ol class="notes">
            {
                content.points.map((point, index) => (
                    <li class="note">
                        <h3 data-i18n={`${sectionKey}.points.${index}.title`}>{point.title}</h3>
                        <p
                            data-i18n-rich={`${sectionKey}.points.${index}.body`}
                            set:html={inlineCodeHtml(point.body)}
                        />
                    </li>
                ))
            }
        </ol>

        {
            sample ? (
                <figure class:list={["file-sheet", "detail-figure", { "is-local": sample.local }]}>
                    <figcaption class="file-sheet-head">
                        <span class="file-name">{sample.file}</span>
                    </figcaption>
                    <ol class="file-lines">
                        {sample.lines.map((line, index) => {
                            const revised = sample.revised?.line === index;

                            return (
                                <li
                                    class:list={["file-line", { "is-heading": line.startsWith("#"), "is-revised": revised }]}
                                    data-rev-static={revised ? "" : undefined}
                                >
                                    <span class="file-line-text" data-i18n={`${sectionKey}.sample.${index}`}>
                                        {line}
                                    </span>
                                    {revised ? <DeltaMark class="file-line-delta" label={String(sample.revised?.rev)} /> : null}
                                </li>
                            );
                        })}
                    </ol>
                </figure>
            ) : null
        }

        {
            tree ? (
                <figure class="file-sheet detail-figure detail-tree">
                    <figcaption class="file-sheet-head">
                        <span class="file-name">your-repo/</span>
                    </figcaption>
                    <ul class="tree">
                        {tree.map((entry, index) => (
                            <li class:list={["tree-row", { "is-local": entry.local }]}>
                                <code>{entry.path}</code>
                                <span class="tree-note" data-i18n={`workspace.tree.${index}.note`}>
                                    {entry.note}
                                </span>
                            </li>
                        ))}
                    </ul>
                </figure>
            ) : null
        }
    </div>

    <p class="sheet-id" aria-hidden="true">{sheetId}</p>
</section>
