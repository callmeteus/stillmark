---
import { inlineCodeHtml } from "../../utils/InlineCode";

interface Props {
    commandHeader: string;
    descriptionHeader: string;
    modeConsoleLabel: string;
    modeAgentLabel: string;
    modeGroupLabel: string;
    rows: string[][];
    agentOnlyRows: string[][];
}

const {
    commandHeader,
    descriptionHeader,
    modeConsoleLabel,
    modeAgentLabel,
    modeGroupLabel,
    rows,
    agentOnlyRows
} = Astro.props;

/**
 * Maps a terminal command to the agent slash form (`stillmark plan add` -> `/stillmark plan add`).
 */
function toAgentCommand(cmd: string): string {
    if (cmd.startsWith("stillmark ")) {
        return `/${cmd}`;
    }

    return cmd;
}
---

<div class="command-reference" data-command-reference data-mode="agent">
    <div
        class="segmented command-reference-mode"
        role="group"
        aria-label={modeGroupLabel}
        data-i18n-aria-label="commands.modeGroupLabel"
    >
        <button
            type="button"
            class="segmented-btn"
            data-command-mode="agent"
            aria-pressed="true"
            data-i18n="commands.modeAgentLabel"
        >
            {modeAgentLabel}
        </button>
        <button
            type="button"
            class="segmented-btn"
            data-command-mode="console"
            aria-pressed="false"
            data-i18n="commands.modeConsoleLabel"
        >
            {modeConsoleLabel}
        </button>
    </div>

    <table class="schedule">
        <thead>
            <tr>
                <th scope="col" data-i18n="commands.tableCommand">{commandHeader}</th>
                <th scope="col" data-i18n="commands.tableDescription">{descriptionHeader}</th>
            </tr>
        </thead>
        <tbody>
            {
                rows.map(([cmd, desc], index) => (
                    <tr>
                        <th scope="row" class="schedule-cmd break-code">
                            <code class="cmd-console" data-i18n={`commands.rows.${index}.0`}>{cmd}</code>
                            <code class="cmd-agent" data-i18n-agent={`commands.rows.${index}.0`}>{toAgentCommand(cmd)}</code>
                        </th>
                        <td data-i18n-rich={`commands.rows.${index}.1`} set:html={inlineCodeHtml(desc)} />
                    </tr>
                ))
            }
            {
                agentOnlyRows.map(([cmd, desc], index) => (
                    <tr class="command-reference-agent-only">
                        <th scope="row" class="schedule-cmd break-code">
                            <code class="cmd-agent" data-i18n={`commands.agentOnlyRows.${index}.0`}>{cmd}</code>
                        </th>
                        <td data-i18n-rich={`commands.agentOnlyRows.${index}.1`} set:html={inlineCodeHtml(desc)} />
                    </tr>
                ))
            }
        </tbody>
    </table>
</div>

<script>
    function initCommandReference(root: HTMLElement) {
        const buttons = root.querySelectorAll<HTMLButtonElement>("[data-command-mode]");

        function setMode(mode: "agent" | "console") {
            root.dataset.mode = mode;

            for (const button of buttons) {
                const pressed = button.dataset.commandMode === mode;

                button.setAttribute("aria-pressed", pressed ? "true" : "false");
            }
        }

        for (const button of buttons) {
            button.addEventListener("click", () => {
                const mode = button.dataset.commandMode;

                if (mode === "agent" || mode === "console") {
                    setMode(mode);
                }
            });
        }
    }

    for (const root of document.querySelectorAll<HTMLElement>("[data-command-reference]")) {
        initCommandReference(root);
    }
</script>
